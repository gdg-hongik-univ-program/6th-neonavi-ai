# 이 파일을 `frontend/.env` 로 복사한 뒤 실제 키를 채운다. (.env 는 git 에 올라가지 않음)
# 값을 바꾸면 `npm start` 를 재시작해야 반영된다.

# 카카오 JavaScript 키 — 브라우저에서 지도를 띄울 때 사용 (REST 키와 다름)
# Kakao Developers > 내 애플리케이션 > 플랫폼 키 > JavaScript 키
REACT_APP_KAKAO_JS_KEY=

# 백엔드 주소. 비워두면 http://127.0.0.1:8000 을 쓴다.
# REACT_APP_API_BASE_URL=http://127.0.0.1:8000
